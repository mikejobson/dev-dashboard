<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <AssemblyName>devdash-agent</AssemblyName>
    <RootNamespace>DevDash.Agent</RootNamespace>
    <!-- No ICU: the self-contained Linux binary then runs on a machine without libicu, and every
         binary is smaller. The agent only does ordinal comparisons and invariant formatting. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- Windows only: the same program built for the Windows subsystem, so the scheduled task can run it
       with no console window. Published beside the console build as devdash-agentw.exe
       (scripts/publish-agent.sh). A custom property rather than -p:AssemblyName, which would also
       rename the referenced projects. -->
  <PropertyGroup Condition="'$(DevDashWindowless)' == 'true'">
    <OutputType>WinExe</OutputType>
    <AssemblyName>devdash-agentw</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Defaults travel inside the assembly, so the single-file binary needs no loose appsettings.json. -->
    <EmbeddedResource Include="appsettings.json" LogicalName="appsettings.json" />
    <Content Update="appsettings.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <!-- Test builds only: -p:DevDashUpdatePublicKeyFile=<pem> embeds that public key, and the build trusts it
       in place of the release key in Updates/ReleaseSigning.cs. The update tests in CI use it with a
       throwaway key. scripts/publish-agent.sh never sets it, and the release workflow checks that the
       binaries it built accept the real signature, so a test key cannot reach a release. There is no
       runtime equivalent. -->
  <ItemGroup Condition="'$(DevDashUpdatePublicKeyFile)' != ''">
    <EmbeddedResource Include="$(DevDashUpdatePublicKeyFile)" LogicalName="devdash-update-test-public-key.pem" Link="Updates\test-public-key.pem" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DevDash.Contracts\DevDash.Contracts.csproj" />
    <ProjectReference Include="..\DevDash.Core\DevDash.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DevDash.Core.Tests" />
  </ItemGroup>
</Project>
