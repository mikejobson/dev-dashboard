{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5210",
  "Hub": {
    "DataDirectory": "devdash-data",
    "OnlineWindowMinutes": 35,
    "Cleanup": {
      "UncommittedDays": 14,
      "StashDays": 30,
      "WorktreeStaleDays": 30,
      "BuildDirBytes": 524288000,
      "UntouchedDays": 180,
      "StalePullRequestDays": 30,
      "StaleDraftDays": 14
    },
    "Updates": {
      "Enabled": true,
      "Repository": "mikejobson/dev-dashboard",
      "CheckIntervalMinutes": 60,
      "IncludePrereleases": false
    },
    "PublicUrl": "",
    "Alerts": {
      "Enabled": true,
      "EvaluateIntervalMinutes": 5,
      "RenotifyHours": 0,
      "TimeZone": "",
      "QuietHours": { "Enabled": false, "Start": "22:00", "End": "07:00" },
      "Triggers": {
        "AtRisk": { "Enabled": true, "Days": 3, "Level": "High" },
        "MachineOffline": { "Enabled": true, "Minutes": 60, "Ignore": "" },
        "Diverged": { "Enabled": true },
        "CiFailed": { "Enabled": true, "IncludeDrafts": false },
        "ActionFailed": { "Enabled": true },
        "DailyDigest": { "Enabled": false, "Time": "08:00" }
      },
      "Channels": {
        "Webhook": { "Enabled": false },
        "Ntfy": { "Enabled": false, "Server": "https://ntfy.sh" },
        "HomeAssistant": { "Enabled": false, "Url": "" }
      }
    }
  },
  "Auth": {
    "Mode": "LocalDev",
    "RequireLoopback": true
  },
  "GitHub": {
    "Enabled": true,
    "Token": "",
    "PollIntervalMinutes": 5,
    "ExcludeOrgs": [],
    "RecentDays": 30,
    "ReposPerOrg": 30,
    "MentionDays": 14
  }
}
