@* One line chart of the History page: a legend when there are several lines, the SVG (HistoryCharts),
   and the same numbers as a table for anyone who would rather read them. *@
<div class="card chart">
    <div class="chart-head">
        <h3>@Title</h3>
        @if (Series.Count > 1)
        {
            <span class="chart-legend small">
                @foreach (var s in Series)
                {
                    <span><i class="s@(s.Slot % HistoryCharts.Slots)"></i>@s.Name</span>
                }
            </span>
        }
    </div>
    @if (Series.All(s => s.Points.Count == 0))
    {
        <div class="muted small">Nothing recorded in this range.</div>
    }
    else
    {
        @((MarkupString)HistoryCharts.Line(Series, From, To, Format, Label))
        @if (Note is not null)
        {
            <div class="muted small">@Note</div>
        }
        <details class="heat-months small">
            <summary class="muted">As a table</summary>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Day</th>@foreach (var s in Series) { <th class="right">@s.Name</th> }</tr></thead>
                    <tbody>
                        @foreach (var day in Series.SelectMany(s => s.Points).Select(p => p.Day).Distinct().OrderDescending())
                        {
                            <tr>
                                <td>@HistoryCharts.DayLabel(day, To)</td>
                                @foreach (var s in Series)
                                {
                                    var hit = s.Points.Where(p => p.Day == day).Select(p => (double?)p.Value).FirstOrDefault();
                                    <td class="right">@(hit is { } v ? Format(v) : "")</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<ChartSeries> Series { get; set; } = [];
    [Parameter, EditorRequired] public DateOnly From { get; set; }
    [Parameter, EditorRequired] public DateOnly To { get; set; }
    [Parameter] public Func<double, string> Format { get; set; } = HistoryCharts.Number;
    [Parameter] public string? Note { get; set; }

    private string Label => $"{Title}, {HistoryCharts.DayLabel(From, To)} to {HistoryCharts.DayLabel(To, To)}: "
        + string.Join("; ", Series.Where(s => s.Points.Count > 0).Select(s => $"{s.Name} {Format(s.Points.MaxBy(p => p.Day).Value)} latest"));
}
