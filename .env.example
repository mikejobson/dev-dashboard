# DevDash hub: copy to .env (which git ignores) and fill in. Used by docker-compose.yml.

# ---- Tailscale (required) ---------------------------------------------------------------------
# The hub joins your tailnet as its own ephemeral node and serves HTTPS at
#   https://<TS_HOSTNAME>.<your-tailnet>.ts.net
# In the admin console, turn on MagicDNS and HTTPS certificates first (DNS page).
#
# Option A (recommended, never expires): an OAuth client secret with the "auth_keys" write scope
# and tag:devdash. The query string makes every node it creates ephemeral and pre-approved:
#   TS_AUTHKEY=tskey-client-xxxxxxxx?ephemeral=true&preauthorized=true
#   TS_EXTRA_ARGS=--advertise-tags=tag:devdash
# The tag must exist in your ACL policy, e.g. "tagOwners": { "tag:devdash": ["autogroup:admin"] }.
#
# Option B: an auth key with "Ephemeral" ticked (Settings > Keys > Generate auth key). Expires after
# at most 90 days; generate it as Reusable so a restart after the node is removed can rejoin.
#   TS_AUTHKEY=tskey-auth-xxxxxxxx
# Leave TS_EXTRA_ARGS empty with a plain auth key: requesting a tag the key wasn't created with fails
# with "requested tags [tag:devdash] are invalid or not permitted".
#
# Note: an API access token (tskey-api-...) cannot join a node; use one of the above.
TS_AUTHKEY=
TS_EXTRA_ARGS=
TS_HOSTNAME=devdash

# ---- Who may open the dashboard ---------------------------------------------------------------
# Comma-separated tailnet logins, as shown in the admin console Users page. Set this: whoever can open
# the dashboard can queue actions on your machines. Empty = any user on your tailnet, including users of
# nodes shared into it, and the dashboard shows a warning (tagged devices are always refused; agents use API keys).
DEVDASH_ALLOWED_USERS=

# ---- GitHub (required for the GitHub page and PR/issue findings) ------------------------------
# The container has no `gh`, so pass a token. Least access: a fine-grained PAT with read-only Metadata,
# Contents, Pull requests and Issues on your repos (plus Issues: write only if you turn on issue write-back),
# and read-only org Members. `gh auth token` also works, but it can write to every repo you can.
GITHUB_TOKEN=
GITHUB_ENABLED=true

# ---- Alerts (optional) -------------------------------------------------------------------------
# The address you open the dashboard at, so alerts can link back to it, e.g.
#   DEVDASH_PUBLIC_URL=https://devdash.your-tailnet.ts.net
# Channels (ntfy, Home Assistant, a webhook) and triggers are set up on the Alerts page.
DEVDASH_PUBLIC_URL=

# ---- Claude API (optional, for phase 5: repo descriptions and the daily brief) ----------------
# Not used yet; the hub runs fine without it.
ANTHROPIC_API_KEY=

# ---- Hub version ------------------------------------------------------------------------------
# Which published hub image `docker compose up -d` runs: ghcr.io/mikejobson/dev-dashboard-hub:<this>.
# "latest" follows releases (update with `docker compose pull && docker compose up -d`); a number
# such as 0.2.0 pins one. Ignored when you build from source with `docker compose up -d --build`.
DEVDASH_VERSION=latest

# ---- Misc -------------------------------------------------------------------------------------
TZ=Europe/London
