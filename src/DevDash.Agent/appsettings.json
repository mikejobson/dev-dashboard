{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Agent": {
    "HubUrl": "http://localhost:5210",
    "ApiKeyFile": "",
    "ScanIntervalMinutes": 15,
    "SizeScanIntervalHours": 24,
    "Watch": true,
    "Activity": true,
    "Toolchains": {
      "Enabled": true,
      "IntervalHours": 6,
      "TimeoutSeconds": 10
    },
    "Dependencies": {
      "Enabled": true,
      "IntervalHours": 24,
      "RetryHours": 2,
      "TimeoutSeconds": 120
    },
    "AutoFetch": {
      "Enabled": true,
      "IntervalHours": 4,
      "TimeoutSeconds": 60
    },
    "Updates": {
      "Mode": "notify",
      "Repository": "mikejobson/dev-dashboard",
      "CheckIntervalHours": 6
    }
  }
}
