{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5210",
  "Hub": {
    "DataDirectory": "devdash-data",
    "OnlineWindowMinutes": 35,
    "Cleanup": {
      "UncommittedDays": 14,
      "StashDays": 30,
      "WorktreeStaleDays": 30,
      "BuildDirBytes": 524288000,
      "UntouchedDays": 180,
      "StalePullRequestDays": 30,
      "StaleDraftDays": 14
    }
  },
  "Auth": {
    "Mode": "LocalDev",
    "RequireLoopback": true
  },
  "GitHub": {
    "Enabled": true,
    "Token": "",
    "PollIntervalMinutes": 5,
    "ExcludeOrgs": [],
    "RecentDays": 30,
    "ReposPerOrg": 30,
    "MentionDays": 14
  }
}
