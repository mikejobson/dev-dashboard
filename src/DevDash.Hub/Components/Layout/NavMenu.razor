@* The main navigation with its counts. What each count means is defined in NavCounts. *@
@inherits LivePage
@inject NavCounts Counts

<nav class="nav" aria-label="Main">
    <NavLink href="" Match="NavLinkMatch.All">Overview</NavLink>
    <NavLink href="local">Local</NavLink>
    <NavLink href="github">
        GitHub
        @if (_github > 0)
        {
            <span class="nav-count" title="@Fmt.Count(_github, "review request") waiting on you">@_github</span>
        }
    </NavLink>
    <NavLink href="issues">
        Issues
        @if (_issues > 0)
        {
            <span class="nav-count" title="@Fmt.Count(_issues, "open issue") in your repos">@_issues</span>
        }
    </NavLink>
    <NavLink href="cleanup">
        Cleanup
        @if (_cleanup > 0)
        {
            <span class="nav-count danger" title="@Fmt.Count(_cleanup, "high-severity finding")">@_cleanup</span>
        }
    </NavLink>
    <NavLink href="safety">
        Safety
        @if (_safety > 0)
        {
            <span class="nav-count danger" title="@Fmt.Count(_safety, "repo") with commits that are on no remote">@_safety</span>
        }
    </NavLink>
    <NavLink href="alerts">
        Alerts
        @if (_alerts > 0)
        {
            <span class="nav-count" title="@Fmt.Count(_alerts, "alert") open now">@_alerts</span>
        }
    </NavLink>
    <NavLink href="machines">Machines</NavLink>
    <NavLink href="claude">Claude</NavLink>
</nav>

@code {
    private int _github, _cleanup, _safety, _alerts, _issues;

    protected override async Task LoadAsync()
    {
        _github = Counts.GitHub();
        _safety = Counts.Safety();
        _alerts = await Counts.AlertsAsync();
        _issues = await Counts.IssuesAsync();
        try
        {
            _cleanup = await Counts.CleanupAsync();
        }
        catch (Exception)
        {
            // The count is a nicety: a rule that throws must not take the navigation down with it.
            _cleanup = 0;
        }
    }
}
