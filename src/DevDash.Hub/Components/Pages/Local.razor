@page "/local"
@inherits LivePage
@inject SnapshotStore Snapshots
@inject RepoCatalog Catalog
@inject NavigationManager Nav
@inject RefreshBoard Refreshes
@inject RepoNotes Notes

<PageTitle>Local · DevDash</PageTitle>

<div class="page-head">
    <div>
        <h1>Local</h1>
        <p>Every entry in your code folders, by machine.</p>
    </div>
    <span class="muted small">@(Repos.Count + (_notGit ? 0 : Folders.Count)) of @_rows.Count shown</span>
</div>

<div class="toolbar">
    <input type="search" placeholder="Search name, owner, branch, #tag…" aria-label="Search repos" @bind="_search" @bind:event="oninput" />
    <select aria-label="Owner" value="@(Owner ?? "")" @onchange="e => SetOwner(e.Value?.ToString())">
        <option value="">All owners</option>
        @foreach (var (owner, count) in _owners)
        {
            <option value="@owner">@owner (@count)</option>
        }
    </select>
    @if (_tags.Count > 0)
    {
        <select aria-label="Tag" value="@(ActiveTag ?? "")" @onchange="e => SetTag(e.Value?.ToString())">
            <option value="">All tags</option>
            @foreach (var (tag, count) in _tags)
            {
                <option value="@tag">#@tag (@count)</option>
            }
        </select>
    }
    <button type="button" class="toggle @(_dirty ? "on" : "")" aria-pressed="@_dirty" @onclick="() => _dirty = !_dirty">Dirty</button>
    <button type="button" class="toggle @(_ahead ? "on" : "")" aria-pressed="@_ahead" @onclick="() => _ahead = !_ahead">Ahead</button>
    <button type="button" class="toggle @(_behind ? "on" : "")" aria-pressed="@_behind" @onclick="() => _behind = !_behind">Behind</button>
    <button type="button" class="toggle @(_stale ? "on" : "")" aria-pressed="@_stale" @onclick="() => _stale = !_stale">Stale</button>
    <button type="button" class="toggle @(_notGit ? "on" : "")" aria-pressed="@_notGit" @onclick="() => _notGit = !_notGit">Not git</button>
    <span class="sort-links small">
        <span class="muted">Sort</span>
        @SortLink(LocalSort.Activity, "Last activity")
        @SortLink(LocalSort.Name, "Name")
        @SortLink(LocalSort.State, "State")
    </span>
</div>

@if (Refreshes.Error is { } refreshError)
{
    <div class="banner danger">Could not ask for a refresh: @refreshError</div>
}

@if (_machines.Count == 0)
{
    <div class="card empty">No machine has reported yet.</div>
}
else
{
    @Table(Repos, true)

    @if (!_notGit && Folders.Count > 0)
    {
        @* Folders that are not repos (backups, loose files) stay out of the way; the "Not git" filter lists them on their own. *@
        <details class="fold" id="non-git">
            <summary><strong>@Fmt.Count(Folders.Count, "non-git folder")</strong> <span class="muted small">backups, loose files and other folders that are not repos</span></summary>
            @Table(Folders, false)
        </details>
    }
}

@code {
    private const int StaleDays = 180;

    /// <summary><c>?sort=activity|name|state</c>. Last activity is the default.</summary>
    [SupplyParameterFromQuery] public string? Sort { get; set; }

    /// <summary><c>?dir=asc|desc</c>. Without it each column sorts its natural way: newest first, A to Z.</summary>
    [SupplyParameterFromQuery] public string? Dir { get; set; }

    /// <summary><c>?owner=…</c> keeps one remote owner, or <c>(local)</c> for entries with no remote.</summary>
    [SupplyParameterFromQuery] public string? Owner { get; set; }

    private IReadOnlyList<MachineView> _machines = [];
    private IReadOnlyList<RepoRow> _rows = [];
    private IReadOnlyDictionary<string, string> _hints = new Dictionary<string, string>();
    private IReadOnlyList<(string Owner, int Count)> _owners = [];
    private string _search = "";
    private bool _dirty, _ahead, _behind, _stale, _notGit;
    private Dictionary<string, RefreshAvailability> _refreshable = new(StringComparer.OrdinalIgnoreCase);

    private LocalSort ActiveSort => LocalView.ParseSort(Sort);

    private bool Descending => Dir switch
    {
        "asc" => false,
        "desc" => true,
        _ => LocalView.DefaultDescending(ActiveSort),
    };

    /// <summary><c>?tag=…</c> keeps the repos with that tag (§20).</summary>
    [SupplyParameterFromQuery] public string? Tag { get; set; }

    private RepoNoteSet _notes = RepoNoteSet.Empty;
    private IReadOnlyList<(string Tag, int Count)> _tags = [];

    private string? ActiveTag => RepoTags.Normalize(Tag);

    /// <summary>Pinned repos first, whatever the sort; within each part the chosen order.</summary>
    private List<RepoRow> Sorted => RepoTags.PinnedFirst(LocalView.Sort(_rows.Where(Matches), ActiveSort, Descending), r => _notes.IsPinned(r.Key));

    private string TagUrl(string tag) => Url(ActiveSort, Descending, Owner, tag);

    private void SetTag(string? tag) => Nav.NavigateTo(Url(ActiveSort, Descending, Owner, tag), replace: true);

    /// <summary>The main table: git repos, or only the non-git entries when that filter is on.</summary>
    private List<RepoRow> Repos => Sorted.Where(r => _notGit ? r.Kind != EntryKind.GitRepo : r.Kind == EntryKind.GitRepo).ToList();

    private List<RepoRow> Folders => Sorted.Where(r => r.Kind != EntryKind.GitRepo).ToList();

    protected override async Task LoadAsync()
    {
        _machines = Snapshots.Machines;
        _rows = await Catalog.GetAsync();
        _hints = LocalView.Disambiguators(_rows);
        _owners = LocalView.Owners(_rows);
        _notes = await Notes.GetAsync();
        _tags = _notes.TagCounts();
        _refreshable = _machines.ToDictionary(m => m.MachineId, Refreshes.For, StringComparer.OrdinalIgnoreCase);
        await Refreshes.LoadAsync();
        TickWhile(() => Refreshes.Ticking);
    }

    private async Task RefreshAsync(RefreshTarget target)
    {
        await Refreshes.QueueAsync([target]);
        TickWhile(() => Refreshes.Ticking);
    }

    private string Url(LocalSort sort, bool descending, string? owner, string? tag) => Nav.GetUriWithQueryParameters(Nav.ToAbsoluteUri("local").GetLeftPart(UriPartial.Path), new Dictionary<string, object?>
    {
        ["sort"] = sort == LocalSort.Activity ? null : sort.ToString().ToLowerInvariant(),
        ["dir"] = descending == LocalView.DefaultDescending(sort) ? null : descending ? "desc" : "asc",
        ["owner"] = string.IsNullOrEmpty(owner) ? null : owner,
        ["tag"] = RepoTags.Normalize(tag),
    });

    /// <summary>Clicking the active column flips its direction; another column starts in its natural one.</summary>
    private string SortUrl(LocalSort sort) => Url(sort, sort == ActiveSort ? !Descending : LocalView.DefaultDescending(sort), Owner, ActiveTag);

    private void SetOwner(string? owner) => Nav.NavigateTo(Url(ActiveSort, Descending, owner, ActiveTag), replace: true);

    private string? AriaSort(LocalSort sort) => sort != ActiveSort ? null : Descending ? "descending" : "ascending";

    private RenderFragment SortLink(LocalSort sort, string label) =>
        @<a class="sort @(sort == ActiveSort ? "active" : "")" href="@SortUrl(sort)" title="Sort by @label.ToLowerInvariant()">@label@if (sort == ActiveSort) { <span class="sort-arrow" aria-hidden="true">@(Descending ? "↓" : "↑")</span> }</a>;

    private RenderFragment Table(List<RepoRow> rows, bool sortable) => @<div class="table-wrap sticky-head">
        <table class="stack local-table">
            <thead>
                <tr>
                    <th aria-sort="@AriaSort(LocalSort.Name)">@if (sortable) { @SortLink(LocalSort.Name, "Repo") } else { <span>Folder</span> }</th>
                    @foreach (var machine in _machines)
                    {
                        <th aria-sort="@AriaSort(LocalSort.State)">
                            @if (sortable)
                            {
                                <a class="sort @(ActiveSort == LocalSort.State ? "active" : "")" href="@SortUrl(LocalSort.State)" title="@machine.Machine.Hostname: sort by state, the repos that most need attention first"><span class="dot @(Snapshots.IsOnline(machine) ? "ok" : "")"></span>@machine.Machine.Hostname@if (ActiveSort == LocalSort.State) { <span class="sort-arrow" aria-hidden="true">@(Descending ? "↓" : "↑")</span> }</a>
                            }
                            else
                            {
                                <span title="@machine.Machine.Hostname"><span class="dot @(Snapshots.IsOnline(machine) ? "ok" : "")"></span>@machine.Machine.Hostname</span>
                            }
                        </th>
                    }
                    <th class="right" aria-sort="@AriaSort(LocalSort.Activity)">@if (sortable) { @SortLink(LocalSort.Activity, "Last activity") } else { <span>Last activity</span> }</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows)
                {
                    <tr @key="row.Key">
                        <td class="desc cell-main">
                            <a class="title-link" href="@Fmt.RepoUrl(row.Key)"><strong>@row.Name</strong></a>
                            @if (_hints.TryGetValue(row.Key, out var hint))
                            {
                                <span class="owner hint small" title="Another entry is also called @row.Name">@hint</span>
                            }
                            else if (row.Owner is not null)
                            {
                                <span class="owner muted small">@row.Owner</span>
                            }
                            @if (_notes.For(row.Key) is { IsEmpty: false } note)
                            {
                                <div><RepoTagChips Note="note" TagUrl="TagUrl" QuietTags="_notes.QuietTags" /></div>
                            }
                            @if (row.Description is not null)
                            {
                                <div class="sub clamp-2" title="@row.Description.Text">@row.Description.Text</div>
                            }
                            @* GitHub's view of the repo sits under its name, not in a column: with three or more machines there is no room for one. *@
                            @if (HasGitHubCell(row))
                            {
                                <div class="chips gh-chips">
                                    @if (row.GitHub is { } gh)
                                    {
                                        <a class="chip" href="@Fmt.SafeLink(gh.Url)" target="_blank" rel="noopener">@(gh.IsPrivate ? "private" : "public")</a>
                                        @if (gh.IsArchived) { <span class="chip warn">archived</span> }
                                        @if (row.PullRequests.Count > 0) { <span class="chip info">@row.PullRequests.Count of my PRs</span> }
                                        @if (row.Issues.Count > 0) { <span class="chip info">@row.Issues.Count @(row.Issues.Count == 1 ? "issue" : "issues")</span> }
                                    }
                                    else if (row.RemoteMissing)
                                    {
                                        <span class="chip danger">not found</span>
                                    }
                                    else if (row.IsHosted)
                                    {
                                        <span class="chip muted">@row.Key.Split('/')[0]</span>
                                    }
                                    else if (row.Kind == EntryKind.GitRepo)
                                    {
                                        <span class="chip warn">local only</span>
                                    }
                                </div>
                            }
                        </td>
                        @foreach (var machine in _machines)
                        {
                            var clones = row.Clones.Where(c => c.Machine.MachineId == machine.MachineId).ToList();
                            <td data-label="@machine.Machine.Hostname" class="@(clones.Count == 0 ? "blank" : "")">
                                <div>
                                    @foreach (var clone in clones)
                                    {
                                        var target = RefreshTargets.For(clone);
                                        @* A linked worktree is listed under its main working tree, not as a repo of its own. *@
                                        <div class="clone with-refresh @(clone.IsLinkedWorktree ? "worktree-child" : "")" title="@clone.Entry.Path">
                                            <div class="clone-state">
                                                @if (clones.Count > 1 || clone.DisplayName != row.Name)
                                                {
                                                    <div class="sub mono">@(clone.IsLinkedWorktree ? "↳ " : "")@clone.DisplayName</div>
                                                }
                                                <CloneChips Clone="clone" />
                                            </div>
                                            @if (target is not null)
                                            {
                                                <RefreshButton Compact="true" ShowStatus="false" Availability="_refreshable[machine.MachineId]" Status="Refreshes.StatusOf(target)"
                                                               What="@($"Rescan {clone.Entry.Name} on {machine.Machine.Hostname} now")" OnRefresh="() => RefreshAsync(target)" />
                                            }
                                        </div>
                                    }
                                </div>
                            </td>
                        }
                        <td data-label="Last activity" class="cell-when right nowrap sub" title="@Fmt.Date(row.LastActivity)">@Fmt.Ago(row.LastActivity, Now)</td>
                    </tr>
                }
                @if (rows.Count == 0)
                {
                    <tr><td class="empty" colspan="@(_machines.Count + 2)">Nothing matches these filters.</td></tr>
                }
            </tbody>
        </table>
    </div>;

    private static bool HasGitHubCell(RepoRow row) => row.GitHub is not null || row.RemoteMissing || row.IsHosted || row.Kind == EntryKind.GitRepo;

    private bool Matches(RepoRow row)
    {
        if (_dirty && !row.AnyDirty) { return false; }
        if (_ahead && !row.AnyAhead) { return false; }
        if (_behind && !row.AnyBehind) { return false; }
        if (_stale && !(row.LastActivity is { } last && (Now - last).TotalDays >= StaleDays)) { return false; }
        if (!string.IsNullOrEmpty(Owner) && !string.Equals(LocalView.OwnerOf(row), Owner, StringComparison.OrdinalIgnoreCase)) { return false; }
        if (!_notes.Matches(row.Key, ActiveTag)) { return false; }

        // "#client" in the search box is a tag filter too.
        var (searchTag, term) = RepoTags.SplitSearch(_search);
        if (!_notes.Matches(row.Key, searchTag)) { return false; }
        if (term.Length == 0)
        {
            return true;
        }

        var note = _notes.For(row.Key);
        return Contains(row.Name) || Contains(row.Owner) || Contains(row.Key) || Contains(row.Description?.Text) || Contains(note.Note)
            || row.Clones.Any(c => Contains(c.Git?.Branch) || Contains(c.Entry.Name));

        bool Contains(string? value) => value is not null && value.Contains(term, StringComparison.OrdinalIgnoreCase);
    }
}
