@page "/machines"
@inherits LivePage
@inject SnapshotStore Snapshots
@inject ApiKeyService Keys
@inject ActionQueue Actions
@inject AgentUpdates Updates
@inject ReleaseStore Releases
@inject ReleasePoller ReleaseChecks
@inject ActionBoard Board
@inject TombstoneStore Tombstones
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider Auth

<PageTitle>Machines · DevDash</PageTitle>

<div class="page-head">
    <div>
        <h1>Machines</h1>
        <p>Agents that report to this hub, and the API keys they use.</p>
    </div>
    <div class="toolbar">
        @if (Releases.Current is { } latest)
        {
            <span class="muted small" title="@(Releases.Status.LastCheckedAt is { } at ? $"Checked {Fmt.Date(at)}" : "")">
                Latest agent release
                @if (latest.Url is not null)
                {
                    <a href="@Fmt.SafeLink(latest.Url)" target="_blank" rel="noopener" class="mono">@latest.Version</a>
                }
                else
                {
                    <span class="mono">@latest.Version</span>
                }
                @if (!latest.Signed)
                {
                    <span class="chip muted gap" title="This release has no checksums.txt.sig. Agents only install signed releases, so it cannot be installed from here.">not signed</span>
                }
                · checked @Fmt.Ago(Releases.Status.LastCheckedAt, Now)
            </span>
        }
        else if (Releases.Status.Enabled)
        {
            <span class="muted small">@(Releases.Status.LastError is null ? "No agent release found yet." : "Latest agent release unknown.")</span>
        }
        @if (Releases.Status.Enabled)
        {
            <button type="button" title="Ask GitHub for the latest release now" @onclick="ReleaseChecks.RequestPoll">Check now</button>
        }
        @if (_updatable.Count > 1)
        {
            <button type="button" class="primary" title="Queue the update for every machine that is behind and accepts updates. You confirm first." @onclick="() => AskAsync(_updatable)">Update all (@_updatable.Count)</button>
        }
    </div>
</div>

@if (Releases.Status is { Enabled: true, LastError: { } releaseError })
{
    <div class="banner warn">Could not check for a new agent release: @releaseError</div>
}

@if (_machines.Count == 0)
{
    <div class="card empty">No machine has reported yet.</div>
}
else
{
    <div class="table-wrap">
        <table class="stack machines-table">
            <thead>
                <tr><th>Machine</th><th>System</th><th>Agent</th><th>Scan</th><th>Roots</th><th>Actions</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var machine in _machines)
                {
                    var online = Snapshots.IsOnline(machine);
                    var home = Fmt.HomeOf(machine.Snapshot.Roots);
                    <tr id="machine-@machine.MachineId" @key="machine.MachineId">
                        <td class="cell-main cell-machine">
                            <div class="truncate" title="@machine.Machine.Hostname"><span class="dot @(online ? "ok" : "")"></span><strong>@machine.Machine.Hostname</strong></div>
                            <div class="sub mono truncate" title="@machine.MachineId">@machine.MachineId</div>
                            @* Last seen sits here rather than in a column of its own, so three or more machines fit a laptop-width page. *@
                            <div class="sub" title="Last seen @Fmt.Date(machine.LastSeenAt)"><span class="chip @(online ? "ok" : "muted")">@(online ? "online" : "offline")</span> @Fmt.Ago(machine.LastSeenAt, Now)</div>
                        </td>
                        <td data-label="System" class="cell-system">
                            <div>
                                <div class="nowrap">@(machine.Machine.OsDescription ?? machine.Machine.Os)</div>
                                @if (machine.Machine.TailscaleName is not null)
                                {
                                    <div class="sub mono truncate" title="@machine.Machine.TailscaleName">@machine.Machine.TailscaleName</div>
                                }
                            </div>
                        </td>
                        <td data-label="Agent">
                            <div>
                            @{
                                var update = Updates.For(machine);
                                var updating = _pendingUpdates.GetValueOrDefault(machine.MachineId);
                            }
                            <span class="mono">@machine.Machine.AgentVersion</span>
                            @if (update.State == AgentUpdateState.UpToDate)
                            {
                                <span class="chip ok gap" title="This is the latest release.">up to date</span>
                            }
                            else if (update.Behind)
                            {
                                <span class="chip warn gap" title="@(update.WhyNot ?? $"Release {update.Latest} is newer than this agent.")">Update available: @update.Latest</span>
                            }
                            <div class="sub">
                                @switch (AgentUpdateModes.Normalize(machine.Machine.UpdateMode))
                                {
                                    case AgentUpdateModes.Auto:
                                        <span title="This agent installs new releases itself, and accepts an update queued from here.">updates: auto</span>
                                        break;
                                    case AgentUpdateModes.Notify:
                                        <span title="This agent updates when asked from here, never on its own.">updates: on request</span>
                                        break;
                                    case AgentUpdateModes.Off:
                                        <span title="This agent refuses updates from the dashboard (Agent:Updates:Mode is off, or it is not an installed release).">updates: off</span>
                                        break;
                                    default:
                                        <details class="chip-details">
                                            <summary class="chip warn" title="@ReinstallWhy">reinstall needed</summary>
                                            <div class="sub">@ReinstallWhy</div>
                                        </details>
                                        break;
                                }
                            </div>
                            @if (updating is not null)
                            {
                                <div><span class="chip info" title="Queued by @updating.QueuedBy at @Fmt.Date(updating.QueuedAt)">@(updating.Status == AgentActionStatus.Claimed ? "updating" : "update queued")</span></div>
                            }
                            else if (update.CanUpdate)
                            {
                                <div><button type="button" class="run" title="Ask this machine's agent to install @update.Latest. You confirm first." @onclick="() => AskAsync([machine])">Update</button></div>
                            }
                            else if (update is { Behind: true, WhyNot: { } whyNot } && AgentUpdateModes.Normalize(machine.Machine.UpdateMode) is not null)
                            {
                                @* An agent that needs a reinstall already says so in its chip. *@
                                <div class="sub">@whyNot</div>
                            }
                            @if (machine.Machine.LastUpdate is { } last && last.Outcome != AgentUpdateOutcomes.Succeeded)
                            {
                                <div>
                                    <span class="chip danger" title="@Fmt.Date(last.At)">@(last.Outcome == AgentUpdateOutcomes.RolledBack ? $"rolled back from {last.ToVersion} to {last.FromVersion}" : $"update to {last.ToVersion} failed")</span>
                                    <div class="sub">@last.Detail</div>
                                </div>
                            }
                            else if (machine.Machine.LastUpdate is { } good)
                            {
                                <div class="sub" title="@Fmt.Date(good.At)">updated from @good.FromVersion @Fmt.Ago(good.At, Now)</div>
                            }
                            </div>
                        </td>
                        <td data-label="Scan">
                            <div>
                                <span title="@machine.Snapshot.ScanDurationMs ms">@Fmt.Count(machine.Snapshot.Entries.Count, "entry", "entries") in @Fmt.Duration(machine.Snapshot.ScanDurationMs)</span>
                                <div class="sub" title="@Fmt.Date(machine.Snapshot.ScannedAt)">scanned @Fmt.Ago(machine.Snapshot.ScannedAt, Now)</div>
                            </div>
                        </td>
                        <td data-label="Roots" class="mono sub">
                            <div>
                                @foreach (var root in machine.Snapshot.Roots)
                                {
                                    <div class="truncate" title="@root">@Fmt.Tilde(root, home)</div>
                                }
                            </div>
                        </td>
                        <td data-label="Actions" class="cell-actions">
                            @if (machine.Machine.ActionsEnabled)
                            {
                                <span class="chip info" title="This agent runs allowlisted fixes queued from the dashboard, after you confirm each one.">on</span>
                                @if (!machine.Machine.AcceptsRemoveProject)
                                {
                                    <div class="sub" title="@AgentActions.WhyNotAccepted(machine.Machine, AgentActionKind.RemoveProject)">no remove, clean or pull yet</div>
                                }
                                @if (machine.Machine.Archive is { } archive)
                                {
                                    <div class="sub" title="@(archive.Problem ?? $"Archives go to {archive.Folder} ({archive.Format})")">
                                        <div class="mono truncate">archive: @Fmt.Tilde(archive.Folder, home)</div>
                                        @if (archive.Problem is not null)
                                        {
                                            <div><span class="chip warn">not usable</span></div>
                                        }
                                        else if (archive.FreeBytes is { } free)
                                        {
                                            <div>@Fmt.Size(free) free</div>
                                        }
                                    </div>
                                }
                                @if (_removed.Count(r => string.Equals(r.Tombstone.MachineId, machine.MachineId, StringComparison.OrdinalIgnoreCase)) is > 0 and var gone)
                                {
                                    <div class="sub"><a href="machines#removed">@gone removed</a></div>
                                }
                            }
                            else
                            {
                                <span class="chip muted" title="This agent only reports. Start it with --enable-actions to allow Run buttons for this machine.">off</span>
                            }
                        </td>
                        <td class="right cell-buttons">
                            <button type="button" class="danger" title="Remove this machine's data from the hub. It reappears if its agent reports again." @onclick="() => ForgetAsync(machine.MachineId)">Forget</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_asking.Count > 0 && Releases.Current is { } target)
{
    <div class="modal-backdrop" @onclick="Cancel">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="update-agents" @onclick:stopPropagation="true">
            <h3 id="update-agents">Update @(_asking.Count == 1 ? $"the agent on {_asking[0].Machine.Hostname}" : $"{_asking.Count} agents") to @target.Version?</h3>
            <dl class="kv">
                @foreach (var machine in _asking)
                {
                    <dt>@machine.Machine.Hostname</dt>
                    <dd><span class="mono">@machine.Machine.AgentVersion → @target.Version</span> <span class="muted mono">@machine.MachineId</span></dd>
                }
            </dl>
            <p>Each agent is asked to run exactly this, and nothing else:</p>
            <div class="command"><code>@AgentActions.CommandLine(AgentAction.UpdateAgent(target.Version))</code></div>
            <p>
                The hub sends only the version number. The agent downloads the release from GitHub itself, checks its signature against the key it was built with
                and its checksum, runs the new program once to see that it starts, then swaps it in and restarts. If the new version has not reported back here
                within a few minutes, the agent puts the previous one back and says so on this page.
            </p>
            <p>It is recorded as queued by <strong>@_login</strong>. An agent that has not picked it up within @Options.CurrentValue.Actions.ExpiryMinutes minutes never runs it.</p>
            @if (_error is not null)
            {
                <div class="banner danger">@_error</div>
            }
            <div class="modal-actions">
                <button type="button" @onclick="Cancel">Cancel</button>
                <button type="button" class="primary" disabled="@_busy" @onclick="ConfirmAsync">Update @(_asking.Count == 1 ? _asking[0].Machine.Hostname : $"{_asking.Count} agents")</button>
            </div>
        </div>
    </div>
}

@if (_machines.Count > 0)
{
    <h2 id="toolchains">Toolchains <span class="muted small">what each machine has installed, and the repos there that pin something else</span></h2>
    <div class="table-wrap">
        <table class="stack toolchains-table">
            <thead><tr><th>Machine</th><th>Installed</th><th>Repos that pin a version</th><th class="right">Checked</th></tr></thead>
            <tbody>
                @foreach (var row in _toolchains)
                {
                    <tr @key="row.Machine.MachineId">
                        <td class="cell-main nowrap"><strong>@row.Machine.Machine.Hostname</strong></td>
                        <td data-label="Installed">
                            @if (!row.Reported)
                            {
                                <span class="sub">@ToolchainView.WhyNotReported(row.Machine.Machine)</span>
                            }
                            else if (row.Tools.Count == 0)
                            {
                                <span class="sub">None found. The agent looks on its PATH and in the usual install folders.</span>
                            }
                            else
                            {
                                <div class="tool-list">
                                    @foreach (var tool in row.Tools)
                                    {
                                        <div class="tool" title="@string.Join(", ", tool.Versions)">
                                            <span class="tool-name">@ToolNames.Display(tool.Tool)</span>
                                            <span><span class="mono">@ToolchainView.Versions(tool)</span>@if (tool.Managers.Count > 0) { <span class="sub"> · @string.Join(", ", tool.Managers)</span> }</span>
                                        </div>
                                    }
                                </div>
                            }
                        </td>
                        <td data-label="Repos that pin a version" class="@(row.Reported ? "" : "blank")">
                            @if (row.Reported)
                            {
                                <div>
                                    @if (row.Unmet.Count == 0)
                                    {
                                        <span class="chip @(row.Pinned > 0 ? "ok" : "muted")">@(row.Pinned > 0 ? $"all {row.Pinned} satisfied" : "none")</span>
                                    }
                                    else
                                    {
                                        <a class="chip danger" href="cleanup#toolchain-mismatch" title="Open the Cleanup findings">@Fmt.Count(row.Unmet.Count, "pin") not met</a>
                                        <span class="sub"> of @Fmt.Count(row.Pinned, "repo") that pin something</span>
                                        @foreach (var unmet in row.Unmet.Take(UnmetShown))
                                        {
                                            <div class="sub"><a href="@Fmt.RepoUrl(unmet.RepoKey)#toolchains">@unmet.Entry.Name</a>: @ToolNames.Display(unmet.Check.Pin.Tool) <span class="mono">@unmet.Check.Pin.Version</span> (@unmet.Check.Pin.Source)</div>
                                        }
                                        @if (row.Unmet.Count > UnmetShown)
                                        {
                                            <div class="sub"><a href="cleanup#toolchain-mismatch">and @(row.Unmet.Count - UnmetShown) more →</a></div>
                                        }
                                    }
                                </div>
                            }
                        </td>
                        <td data-label="Checked" class="right nowrap sub @(row.Reported ? "" : "blank")" title="@Fmt.Date(row.Machine.Machine.Toolchains?.CollectedAt)">
                            @(row.Reported ? Fmt.Ago(row.Machine.Machine.Toolchains!.CollectedAt, Now) : "")
                            @if (row.Machine.Machine.DependencyChecks is { } deps)
                            {
                                <div title="@(deps ? "This agent runs dotnet list package and npm audit in each repo about once a day. It never restores or installs." : "Dependency checks are off on this machine (Agent:Dependencies:Enabled).")">dependency checks @(deps ? "on" : "off")</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_machines.Any(m => m.Machine.DevServers is not null))
{
    <h2 id="devservers">Dev servers <span class="muted small">listening processes in your repos, and development tools elsewhere</span></h2>
    @foreach (var machine in _machines.Where(m => m.Machine.DevServers?.Problem is not null))
    {
        <p class="muted small">@machine.Machine.Hostname: @machine.Machine.DevServers!.Problem</p>
    }
    <DevServerList Rows="_servers" Now="Now" Empty="No dev server is listening on any machine." />
}

@if (_removed.Count > 0)
{
    <h2 id="removed">Removed projects <span class="muted small">@_removed.Count</span></h2>
    <p class="muted small">Moved to the trash on their machine from the <a href="safety">Safety page</a>. Re-clone puts a fresh clone back in the same folder.</p>
    <RemovedProjects Items="_removed" Now="Now" />
}

<h2>Agent actions <span class="muted small">@(_actions.Count > _actionsShown ? $"last {_actionsShown}" : _actions.Count)</span></h2>
<details class="about small muted">
    <summary>Fixes queued from the dashboard for a machine's own agent to run.</summary>
    <p>
        Off unless that machine's agent was started with <code>--enable-actions</code>. Only a fixed list of operations exists, each one is
        confirmed first, and the agent checks it again before running. A removed project goes to that machine's trash, never deleted. Agent updates are listed here too; they follow each machine's own update
        setting, not <code>--enable-actions</code>. Paths under the machine's home folder are shown as <code>~/…</code>; hover for the full command.
        Refreshes asked for from the Repo and Local pages change nothing, so they are kept out of this list and summarised under it.
    </p>
</details>
<div class="table-wrap">
    <table class="stack actions-table">
        <thead>
            <tr><th>Action</th><th>Machine</th><th>By</th><th>Status</th><th>Result</th><th class="right">Queued</th></tr>
        </thead>
        <tbody>
            @foreach (var action in _actions.Take(_actionsShown))
            {
                <tr @key="action.Id">
                    <td class="cell-main cell-action">
                        <code class="cmd" title="@action.CommandLine">@Fmt.Tilde(action.CommandLine, HomeFor(action.MachineId))</code>
                        @if (action.FindingTitle is not null)
                        {
                            <div class="sub">@action.FindingTitle</div>
                        }
                    </td>
                    <td data-label="Machine" class="nowrap" title="@action.MachineId">@action.MachineName</td>
                    <td data-label="By" class="sub">@action.QueuedBy</td>
                    <td data-label="Status" class="nowrap">
                        <span class="chip @ActionClass(action.Status)">@action.Status.ToString().ToLowerInvariant()</span>
                        <div class="sub">
                            @if (action.CompletedAt is not null)
                            {
                                <span title="@Fmt.Date(action.CompletedAt)">@Fmt.Ago(action.CompletedAt, Now)</span>
                            }
                            else if (action.ClaimedAt is not null)
                            {
                                <span title="@Fmt.Date(action.ClaimedAt)">claimed @Fmt.Ago(action.ClaimedAt, Now)</span>
                            }
                            else
                            {
                                <span title="@Fmt.Date(action.ExpiresAt)">expires @action.ExpiresAt.ToLocalTime().ToString("HH:mm")</span>
                            }
                        </div>
                    </td>
                    <td data-label="Result" class="@(string.IsNullOrWhiteSpace(action.Output) && action.ExitCode is null ? "blank" : "")">
                        @if (!string.IsNullOrWhiteSpace(action.Output))
                        {
                            <details class="output">
                                <summary>@(action.ExitCode is { } exit ? $"exit {exit}" : "details")</summary>
                                <pre>@action.Output</pre>
                            </details>
                        }
                        else if (action.ExitCode is { } exitCode)
                        {
                            <span class="sub">exit @exitCode</span>
                        }
                    </td>
                    <td data-label="Queued" class="cell-when right sub nowrap" title="@Fmt.Date(action.QueuedAt)">@Fmt.Ago(action.QueuedAt, Now)</td>
                </tr>
            }
            @if (_actions.Count == 0)
            {
                <tr><td class="empty" colspan="6">No actions have been queued.</td></tr>
            }
        </tbody>
    </table>
</div>
@if (_actions.Count > _actionsShown)
{
    <div class="more-row">
        <button type="button" @onclick="() => _actionsShown += ActionsPage * 2">Show more</button>
        <span class="muted small">@_actionsShown of @(_actions.Count >= ActionsLoaded ? $"the last {ActionsLoaded}" : _actions.Count.ToString())</span>
    </div>
}

@if (_refreshes.Count > 0)
{
    var failed = _refreshes.Count(r => r.Status is AgentActionStatus.Failed or AgentActionStatus.Expired);
    <details class="fold refresh-log">
        <summary>
            <strong>@Fmt.Count(_refreshes.Count, "refresh", "refreshes")</strong>
            <span class="muted small">
                read-only rescans asked for from the dashboard · last @RefreshStatus.Ago(_refreshes[0].QueuedAt, Now) on @_refreshes[0].MachineName@(failed > 0 ? $" · {failed} did not complete" : "")
            </span>
        </summary>
        <div class="table-wrap">
            <table class="stack actions-table">
                <thead>
                    <tr><th>Entry</th><th>Machine</th><th>By</th><th>Status</th><th>Result</th><th class="right">Asked</th></tr>
                </thead>
                <tbody>
                    @foreach (var refresh in _refreshes.Take(RefreshesShown))
                    {
                        <tr @key="refresh.Id">
                            <td class="cell-main cell-action"><code class="cmd" title="@refresh.RepoPath">@Fmt.Tilde(refresh.RepoPath, HomeFor(refresh.MachineId))</code></td>
                            <td data-label="Machine" class="nowrap" title="@refresh.MachineId">@refresh.MachineName</td>
                            <td data-label="By" class="sub">@refresh.QueuedBy</td>
                            <td data-label="Status" class="nowrap"><span class="chip @ActionClass(refresh.Status)">@refresh.Status.ToString().ToLowerInvariant()</span></td>
                            <td data-label="Result" class="sub @(string.IsNullOrWhiteSpace(refresh.Output) ? "blank" : "")">@refresh.Output</td>
                            <td data-label="Asked" class="cell-when right sub nowrap" title="@Fmt.Date(refresh.QueuedAt)">@Fmt.Ago(refresh.QueuedAt, Now)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_refreshes.Count > RefreshesShown)
        {
            <div class="more-row"><span class="muted small">The newest @RefreshesShown of @_refreshes.Count. Only the last @ActionQueue.KeepRefreshes are kept.</span></div>
        }
    </details>
}

<h2>Agent API keys</h2>

@if (_issued is not null)
{
    <div class="banner info">
        <strong>New key for “@_issued.Entity.Label”.</strong> Copy it now; only its hash is stored and it cannot be shown again.
        <div class="command" style="margin-top:8px">
            <code>@_issued.Plaintext</code>
            <button type="button" class="copy" data-copy="@_issued.Plaintext">Copy</button>
            <button type="button" @onclick="() => _issued = null">Done</button>
        </div>
    </div>
}

<div class="toolbar">
    <input type="text" placeholder="Label, e.g. the machine's name" aria-label="Label for the new key" @bind="_label" @bind:event="oninput" />
    <button type="button" class="primary" @onclick="IssueAsync">Issue key</button>
    <span class="muted small">A key binds to the first machine that uses it.</span>
</div>

<div class="table-wrap">
    <table class="stack keys-table">
        <thead>
            <tr><th>Key</th><th>Label</th><th>Machine</th><th>Created</th><th>Last used</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var key in _keys)
            {
                <tr @key="key.Id" class="@(key.RevokedAt is null ? "" : "revoked")">
                    <td class="mono nowrap cell-main">@key.Prefix…</td>
                    <td data-label="Label">@key.Label</td>
                    <td data-label="Machine" class="mono">@(key.MachineId ?? "not used yet")</td>
                    <td data-label="Created" class="sub nowrap" title="@Fmt.Date(key.CreatedAt)">@Fmt.Ago(key.CreatedAt, Now)</td>
                    <td data-label="Last used" class="sub nowrap" title="@Fmt.Date(key.LastUsedAt)">@Fmt.Ago(key.LastUsedAt, Now)</td>
                    <td class="right cell-buttons">
                        @if (key.RevokedAt is null)
                        {
                            <button type="button" class="danger" @onclick="() => RevokeAsync(key.Id)">Revoke</button>
                        }
                        else
                        {
                            <span class="chip muted" title="@Fmt.Date(key.RevokedAt)">revoked</span>
                        }
                    </td>
                </tr>
            }
            @if (_keys.Count == 0)
            {
                <tr><td class="empty" colspan="6">No keys yet.</td></tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Inject] private IOptionsMonitor<HubOptions> Options { get; set; } = default!;

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    /// <summary><c>?ask=update-all</c>, from the command palette: open the Update confirmation for every agent that is behind. It still has to be confirmed.</summary>
    [SupplyParameterFromQuery] public string? Ask { get; set; }

    // Only once the page is live and loaded, and the address then loses its ?ask so a reload does not ask again.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Loaded || Ask != Palette.AskUpdateAll)
        {
            return;
        }

        Ask = null;
        if (_updatable.Count > 0)
        {
            await AskAsync(_updatable);
            StateHasChanged();
        }

        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("ask", (string?)null), replace: true);
    }

    private const int ActionsPage = 10, ActionsLoaded = 200, RefreshesShown = 20, UnmetShown = 4;
    private IReadOnlyList<MachineToolchains> _toolchains = [];
    private IReadOnlyList<DevServerRow> _servers = [];
    private const string ReinstallWhy = "This agent predates self-update, so it cannot be updated from here. Run the install one-liner on that machine once; after that it updates itself or on request.";

    private int _actionsShown = ActionsPage;
    private IReadOnlyList<MachineView> _updatable = [];
    private IReadOnlyDictionary<string, AgentActionEntity> _pendingUpdates = new Dictionary<string, AgentActionEntity>();
    private IReadOnlyList<MachineView> _asking = [];
    private string _login = "";
    private string? _error;
    private bool _busy;
    private IReadOnlyList<MachineView> _machines = [];
    private IReadOnlyList<ApiKeyEntity> _keys = [];
    private IReadOnlyList<AgentActionEntity> _actions = [];
    private IReadOnlyList<AgentActionEntity> _refreshes = [];
    private IReadOnlyList<RemovedProjectView> _removed = [];
    private IssuedKey? _issued;
    private string _label = "";

    protected override async Task LoadAsync()
    {
        _machines = Snapshots.Machines;
        _toolchains = ToolchainView.For(_machines);
        _servers = DevServerView.Rows(_machines, Now);
        _keys = await Keys.ListAsync();
        // Refreshes are read-only and frequent: listing each one with the fixes and updates would bury those.
        _actions = await Actions.RecentAsync(refreshes: false, ActionsLoaded);
        _refreshes = await Actions.RecentAsync(refreshes: true, ActionQueue.KeepRefreshes);
        await Board.LoadAsync();
        _removed = await Tombstones.ListAsync();
        _pendingUpdates = await Updates.PendingAsync();
        _updatable = Updates.Updatable().Where(m => !_pendingUpdates.ContainsKey(m.MachineId)).ToList();
    }

    private async Task AskAsync(IReadOnlyList<MachineView> machines)
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        _login = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        _error = null;
        _asking = machines;
    }

    private void Cancel()
    {
        _asking = [];
        _error = null;
    }

    // Queues one typed UpdateAgent action per machine. It names the latest release's version; nothing else is sent.
    private async Task ConfirmAsync()
    {
        if (_busy || _asking.Count == 0)
        {
            return;
        }

        _busy = true;
        try
        {
            var errors = new List<string>();
            foreach (var machine in _asking)
            {
                var outcome = await Updates.QueueAsync(machine.MachineId, _login);
                if (!outcome.Ok)
                {
                    errors.Add($"{machine.Machine.Hostname}: {outcome.Error}");
                }
            }

            if (errors.Count == 0)
            {
                _asking = [];
            }
            else
            {
                _error = string.Join(" ", errors);
            }

            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>The home folder of the machine an action ran on, for shortening its paths to <c>~/…</c>.</summary>
    private string? HomeFor(string machineId) =>
        _machines.FirstOrDefault(m => string.Equals(m.MachineId, machineId, StringComparison.OrdinalIgnoreCase)) is { } machine ? Fmt.HomeOf(machine.Snapshot.Roots) : null;

    private static string ActionClass(AgentActionStatus status) => status switch
    {
        AgentActionStatus.Succeeded => "ok",
        AgentActionStatus.Failed => "danger",
        AgentActionStatus.Expired => "muted",
        _ => "info",
    };

    private async Task IssueAsync()
    {
        _issued = await Keys.IssueAsync(_label);
        _label = "";
        await LoadAsync();
    }

    private async Task RevokeAsync(int id)
    {
        await Keys.RevokeAsync(id);
        await LoadAsync();
    }

    private async Task ForgetAsync(string machineId)
    {
        await Snapshots.ForgetAsync(machineId);
        await LoadAsync();
    }
}
