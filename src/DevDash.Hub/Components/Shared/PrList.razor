@* A table of pull requests with CI, review and draft state. On a phone each row becomes a card. *@
@if (Items.Count == 0)
{
    @if (Empty.Length > 0)
    {
        <div class="card muted">@Empty</div>
    }
}
else
{
    <div class="table-wrap">
        <table class="stack pr-table">
            <thead>
                <tr><th>Pull request</th><th>State</th><th>Local</th><th class="right">Updated</th></tr>
            </thead>
            <tbody>
                @foreach (var pr in Items)
                {
                    <tr @key="pr.Url">
                        <td class="cell-main">
                            <a class="title-link" href="@Fmt.SafeLink(pr.Url)" target="_blank" rel="noopener">@pr.Title</a>
                            <div class="sub">
                                @if (ShowRepo)
                                {
                                    <a class="muted" href="@Fmt.RepoUrl(pr.RepoKey)">@pr.Repo</a>
                                }
                                <span>#@pr.Number</span>
                                @if (pr.Author is not null) { <span> · @pr.Author</span> }
                                @if (pr.HeadRef is not null) { <span> · <span class="mono">@pr.HeadRef</span></span> }
                            </div>
                        </td>
                        <td data-label="State" class="@(HasState(pr) ? "" : "blank")">
                            <div class="chips">
                                @if (pr.IsDraft) { <span class="chip muted">draft</span> }
                                @if (pr.Ci == CiState.Success) { <span class="chip quiet-ok">CI passing</span> }
                                @if (pr.Ci == CiState.Failure) { <span class="chip danger">CI failing</span> }
                                @if (pr.Ci == CiState.Pending) { <span class="chip warn">CI running</span> }
                                @if (pr.ReviewDecision == "APPROVED") { <span class="chip ok">approved</span> }
                                @if (pr.ReviewDecision == "CHANGES_REQUESTED") { <span class="chip danger">changes requested</span> }
                                @if (pr.ReviewDecision == "REVIEW_REQUIRED") { <span class="chip muted">review required</span> }
                                @if (pr.Mergeable == "CONFLICTING") { <span class="chip danger">conflicts</span> }
                            </div>
                        </td>
                        <td data-label="Local" class="cell-local">
                            @if (Clones is not null && Clones.TryGetValue(pr.RepoKey, out var clones))
                            {
                                <span class="sub">@string.Join(", ", clones.Select(c => c.Machine.Machine.Hostname).Distinct())</span>
                            }
                            else
                            {
                                <span class="sub">not cloned</span>
                            }
                        </td>
                        <td data-label="Updated" class="cell-when right nowrap sub" title="@Fmt.Date(pr.UpdatedAt)">@Fmt.Ago(pr.UpdatedAt, Now)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private static bool HasState(PullRequestInfo pr) =>
        pr.IsDraft || pr.Ci != CiState.None || pr.ReviewDecision is not null || pr.Mergeable == "CONFLICTING";

    [Parameter, EditorRequired] public IReadOnlyList<PullRequestInfo> Items { get; set; } = [];

    [Parameter] public IReadOnlyDictionary<string, List<CloneView>>? Clones { get; set; }

    [Parameter] public DateTimeOffset Now { get; set; } = DateTimeOffset.UtcNow;

    [Parameter] public string Empty { get; set; } = "Nothing here.";

    /// <summary>False inside a repo's own group or page, where the repo name would only repeat.</summary>
    [Parameter] public bool ShowRepo { get; set; } = true;
}
