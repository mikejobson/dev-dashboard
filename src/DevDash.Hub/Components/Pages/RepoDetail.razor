@page "/repo"
@inherits LivePage
@inject RepoCatalog Catalog
@inject FindingsService Findings
@inject RefreshBoard Refreshes
@inject SafetyService SafetyRows
@inject ActionBoard Actions

<PageTitle>@(_row?.Name ?? "Repo") · DevDash</PageTitle>

@if (_row is null)
{
    <h1>Repo not found</h1>
    <p class="muted">Nothing is known about <code>@Key</code>. It may have been removed from every machine. <a href="local">Back to Local</a>.</p>
}
else
{
    <div class="page-head">
        <div>
            <h1>@_row.Name @if (_row.Owner is not null) { <span class="owner muted small">@_row.Owner</span> }</h1>
            <p>
                @if (_row.Description is not null)
                {
                    @_row.Description.Text <span class="chip muted" title="Where this description came from">@_row.Description.Source</span>
                }
                else
                {
                    <span>No description yet.</span>
                }
            </p>
        </div>
        <div class="chips">
            @if (_targets.Count > 0)
            {
                <RefreshButton Availability="AllAvailability" Status="AllStatus" What="@AllWhat" OnRefresh="() => RefreshAsync(_targets)" />
            }
            @if (_row.GitHub is { } gh)
            {
                <a class="btn" href="@gh.Url" target="_blank" rel="noopener">Open on GitHub</a>
                @if (gh.IsArchived) { <span class="chip warn">archived</span> }
                <span class="chip">@(gh.IsPrivate ? "private" : "public")</span>
                @if (gh.PrimaryLanguage is not null) { <span class="chip muted">@gh.PrimaryLanguage</span> }
            }
            else if (_row.RemoteMissing)
            {
                <span class="chip danger">remote not found on GitHub</span>
            }
            else if (!_row.IsHosted && _row.Kind == EntryKind.GitRepo)
            {
                <span class="chip warn">local only</span>
            }
        </div>
    </div>

    @if (Refreshes.Error is { } refreshError)
    {
        <div class="banner danger">Could not ask for a refresh: @refreshError</div>
    }

    @if (_row.GitHub is { } repo)
    {
        <div class="card">
            <dl class="kv">
                <dt>GitHub</dt><dd><a href="@repo.Url" target="_blank" rel="noopener">@repo.NameWithOwner</a></dd>
                <dt>Default branch</dt><dd><span class="mono">@repo.DefaultBranch</span> at <span class="mono">@Fmt.Sha(repo.HeadSha)</span> — @repo.HeadMessage</dd>
                <dt>Last push</dt><dd>@Fmt.Ago(repo.PushedAt, Now)@(repo.LastPusher is null ? "" : $" · head commit by {repo.LastPusher}")</dd>
                <dt>Open PRs</dt><dd>@repo.OpenPullRequests</dd>
            </dl>
        </div>
    }

    @if (Openable.Count > 0)
    {
        <div class="open-chips repo-open">
            <span class="muted small">Open</span>
            @foreach (var clone in Openable)
            {
                var where = Openable.Count == 1 ? clone.Machine.Machine.Hostname : $"{clone.Machine.Machine.Hostname} · {clone.DisplayName}";
                var cd = $"cd {AgentActions.ShellQuote(clone.Entry.Path)}";
                var edit = $"code {AgentActions.ShellQuote(clone.Entry.Path)}";
                <span class="open-pair">
                    <button type="button" class="chip-btn" data-copy="@cd" title="Copy: @cd">cd · @where</button>
                    <button type="button" class="chip-btn" data-copy="@edit" title="Copy: @edit">code</button>
                </span>
            }
        </div>
    }

    @if (_row.Kind == EntryKind.GitRepo)
    {
        <BranchMapView Clones="_row.Clones" PullRequests="_row.PullRequests" Now="Now" GitHubUrl="@_row.GitHub?.Url" Name="@_row.Clones.FirstOrDefault()?.Entry.Name" />
    }

    @if (_hasActivity)
    {
        <ActivityHeatmap Days="_activity" Today="Today" Compact="true" Caption="in the last year, on every branch"
                         Note="@(_mine is { } mine ? $"{mine} of them with your git email." : null)" />
    }

    @if (_row.GitHub is not null || _row.PullRequests.Count > 0)
    {
        <h2>
            Open pull requests <span class="muted small">@_row.PullRequests.Count</span>
            @if (_row.GitHub is { } hub && hub.OpenPullRequests > _row.PullRequests.Count)
            {
                <span class="muted small"> of @hub.OpenPullRequests on GitHub · <a href="@hub.Url/pulls" target="_blank" rel="noopener">see all</a></span>
            }
        </h2>
        <PrList Items="_row.PullRequests" Now="Now" Clones="_clonesByKey" ShowRepo="false" Empty="No open pull request here is yours, assigned to you or waiting on your review." />
    }

    @if (_row.Issues.Count > 0)
    {
        <h2>Open issues <span class="muted small">@_row.Issues.Count</span></h2>
        <div class="table-wrap">
            <table class="stack">
                <tbody>
                    @foreach (var issue in _row.Issues)
                    {
                        <tr @key="issue.Url">
                            <td class="cell-main">
                                <a class="title-link" href="@issue.Url" target="_blank" rel="noopener">@issue.Title</a> <span class="muted">#@issue.Number</span>
                                <div class="chips">
                                    @if (issue.Assigned) { <span class="chip info">assigned</span> }
                                    @if (issue.Mentioned) { <span class="chip muted">mentioned</span> }
                                    @foreach (var label in issue.Labels) { <span class="chip muted">@label</span> }
                                </div>
                            </td>
                            <td data-label="Updated" class="cell-when right nowrap sub" title="@Fmt.Date(issue.UpdatedAt)">@Fmt.Ago(issue.UpdatedAt, Now)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h2>On your machines</h2>
    <div class="table-wrap">
        <table class="stack">
            <thead>
                <tr><th>Machine</th><th>Path</th><th>State</th><th>Last commit</th><th class="right">Fetched</th><th class="right">Size</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var clone in _row.Clones)
                {
                    var target = RefreshTargets.For(clone);
                    <tr @key="(clone.Machine.MachineId, clone.Entry.Path)" class="@(clone.IsLinkedWorktree ? "worktree-child" : "")">
                        <td class="nowrap cell-main"><a class="title-link" href="machines#machine-@clone.Machine.MachineId">@clone.Machine.Machine.Hostname</a></td>
                        <td data-label="Path" class="mono path">@(clone.IsLinkedWorktree ? "↳ " : "")@clone.Entry.Path</td>
                        <td data-label="State">
                            <div>
                                <CloneChips Clone="clone" />
                                <div class="chips safety-line"><SafetyBadge Safety="_safety.GetValueOrDefault((clone.Machine.MachineId, clone.Entry.Path))" /></div>
                                @if (clone.Git is { Upstream: not null } g)
                                {
                                    <div class="sub">tracks <span class="mono">@g.Upstream</span></div>
                                }
                            </div>
                        </td>
                        <td data-label="Last commit">
                            <div>
                                @if (clone.Git?.LastCommit is { } commit)
                                {
                                    <span class="mono sha">@Fmt.Sha(commit.Sha)</span>@commit.Subject
                                    <div class="sub">@commit.Author · @Fmt.Ago(commit.Date, Now)</div>
                                }
                                else if (clone.Entry.LastModified is not null)
                                {
                                    <span class="sub">modified @Fmt.Ago(clone.Entry.LastModified, Now)</span>
                                }
                            </div>
                        </td>
                        <td data-label="Fetched" class="right nowrap sub @(clone.Git is null ? "blank" : "")">@(clone.Git is null ? "" : Fmt.Ago(clone.Git.LastFetchAt, Now))</td>
                        <td data-label="Size" class="right nowrap sub @(clone.Entry.Size is null ? "blank" : "")">
                            @Fmt.Size(clone.Entry.Size?.TotalBytes)
                            @if (clone.Entry.Size is { ReclaimableBytes: > 0 } size)
                            {
                                <div title="Build output that can be regenerated">@Fmt.Size(size.ReclaimableBytes) reclaimable</div>
                            }
                        </td>
                        <td class="right cell-buttons cell-refresh">
                            @if (target is not null)
                            {
                                <RefreshButton Compact="true" Availability="Refreshes.For(clone.Machine)" Status="Refreshes.StatusOf(target)"
                                               What="@($"Rescan {clone.Entry.Name} on {clone.Machine.Machine.Hostname} now")" OnRefresh="() => RefreshAsync([target])" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Pinned.Count > 0)
    {
        <h2 id="toolchains">Toolchains <span class="muted small">what this repo pins, and whether each machine has it</span></h2>
        <div class="table-wrap">
            <table class="stack">
                <thead><tr><th>Machine</th><th>Pinned</th><th>On that machine</th></tr></thead>
                <tbody>
                    @foreach (var clone in Pinned)
                    {
                        var checks = ToolchainCheck.For(clone.Entry, clone.Machine.Machine);
                        <tr @key="(clone.Machine.MachineId, clone.Entry.Path)">
                            <td class="cell-main nowrap">@clone.Machine.Machine.Hostname@(_row.Clones.Count(c => c.Machine.MachineId == clone.Machine.MachineId) > 1 ? $" · {clone.DisplayName}" : "")</td>
                            <td data-label="Pinned">
                                <div>
                                    @foreach (var pin in clone.Entry.Pins!)
                                    {
                                        <div class="pin-row"><span>@ToolNames.Display(pin.Tool) <span class="mono">@pin.Version</span></span><span class="sub">@pin.Source@(pin.RollForward is null ? "" : $" · rollForward {pin.RollForward}")</span></div>
                                    }
                                </div>
                            </td>
                            <td data-label="On that machine">
                                <div>
                                    @if (checks.Count == 0)
                                    {
                                        <span class="sub">@ToolchainView.WhyNotReported(clone.Machine.Machine)</span>
                                    }
                                    @foreach (var check in checks)
                                    {
                                        <div class="pin-row">
                                            <span class="chip @(check.Status switch { PinStatus.Satisfied => "ok", PinStatus.Missing => "danger", _ => "muted" })">@(check.Status switch { PinStatus.Satisfied => "installed", PinStatus.Missing => "missing", _ => "not checked" })</span>
                                            <span class="sub">@check.Detail</span>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Checked.Count > 0)
    {
        <h2 id="dependencies">Dependencies <span class="muted small">from <code>dotnet list package</code> and <code>npm audit</code>, about once a day</span></h2>
        <div class="table-wrap">
            <table class="stack">
                <thead><tr><th>Machine</th><th>Packages</th><th>Known vulnerabilities</th><th>Outdated</th><th class="right">Checked</th></tr></thead>
                <tbody>
                    @foreach (var clone in Checked)
                    {
                        var health = clone.Entry.Dependencies!;
                        @foreach (var report in health.Reports)
                        {
                            <tr @key="(clone.Machine.MachineId, clone.Entry.Path, report.Ecosystem)">
                                <td class="cell-main nowrap">@clone.Machine.Machine.Hostname@(_row.Clones.Count(c => c.Machine.MachineId == clone.Machine.MachineId) > 1 ? $" · {clone.DisplayName}" : "")</td>
                                <td data-label="Packages">@DependencyView.Ecosystem(report.Ecosystem) <div class="sub mono">@report.Target</div></td>
                                <td data-label="Known vulnerabilities">
                                    <div>
                                        @if (report.Vulnerable is not { } counts)
                                        {
                                            <span class="chip muted" title="@report.Skipped">not checked</span>
                                            <div class="sub">@report.Skipped</div>
                                        }
                                        else if (counts.Total == 0)
                                        {
                                            <span class="chip ok">none known</span>
                                        }
                                        else
                                        {
                                            <div class="chips">
                                                @if (counts.Critical > 0) { <span class="chip danger">@counts.Critical critical</span> }
                                                @if (counts.High > 0) { <span class="chip warn">@counts.High high</span> }
                                                @if (counts.Moderate > 0) { <span class="chip info">@counts.Moderate moderate</span> }
                                                @if (counts.Low > 0) { <span class="chip muted">@counts.Low low</span> }
                                            </div>
                                            <div class="dep-names sub">
                                                @foreach (var package in report.TopVulnerable)
                                                {
                                                    <span title="@package.Severity"><span class="mono">@package.Name@(package.Version is null ? "" : " " + package.Version)</span>@foreach (var advisory in package.Advisories.Where(a => a.StartsWith("GHSA-", StringComparison.Ordinal)))
                                                    {
                                                        <text> </text><a href="https://github.com/advisories/@advisory" target="_blank" rel="noopener">@advisory</a>
                                                    }</span>
                                                }
                                                @if (counts.Total > report.TopVulnerable.Count) { <span>and @(counts.Total - report.TopVulnerable.Count) more</span> }
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td data-label="Outdated">
                                    <div>
                                        @if (report.Outdated is not { } outdated)
                                        {
                                            <span class="sub">@(report.Vulnerable is null ? "" : report.Skipped ?? "not checked")</span>
                                        }
                                        else if (outdated == 0)
                                        {
                                            <span class="chip ok">up to date</span>
                                        }
                                        else
                                        {
                                            <span class="chip muted">@outdated outdated</span>
                                            <div class="dep-names sub">
                                                @foreach (var package in report.TopOutdated)
                                                {
                                                    <span class="mono" title="@package.Name: @package.Current → @package.Latest">@package.Name @package.Latest</span>
                                                }
                                                @if (outdated > report.TopOutdated.Count) { <span>and @(outdated - report.TopOutdated.Count) more</span> }
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td data-label="Checked" class="right nowrap sub" title="@Fmt.Date(health.CheckedAt)">@Fmt.Ago(health.CheckedAt, Now)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }

    @if (BuildOutputs.Count > 0)
    {
        <h2>Build output <span class="muted small">@Fmt.Size(BuildOutputs.Sum(c => c.Entry.Size!.ReclaimableBytes)) that a build or install recreates</span></h2>
        <p class="muted small build-note">Clean deletes the folder for good on that machine. It is not moved to the trash, because a build or an install brings it back.</p>
        <div class="table-wrap">
            <table class="stack build-table">
                <thead>
                    <tr><th>Folder</th><th>Machine</th><th class="right">Size</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var clone in BuildOutputs)
                    {
                        var dirs = clone.Entry.Size!.ReclaimableDirs;
                        @foreach (var dir in dirs)
                        {
                            <tr @key="(clone.Machine.MachineId, dir.Path)">
                                <td class="cell-main mono path" title="@dir.Path">@Relative(clone.Entry.Path, dir.Path)</td>
                                <td data-label="Machine" class="nowrap sub">@clone.Machine.Machine.Hostname@(_row.Clones.Count(c => c.Machine.MachineId == clone.Machine.MachineId) > 1 ? $" · {clone.DisplayName}" : "")</td>
                                <td data-label="Size" class="right nowrap">@Fmt.Size(dir.Bytes)</td>
                                <td class="right cell-buttons">
                                    <ActionButton Machine="clone.Machine" Action="AgentAction.CleanBuildDirs(clone.Entry.Path, [dir.Path])" Label="Clean"
                                                  Ask="@($"Delete {Relative(clone.Entry.Path, dir.Path)} on {clone.Machine.Machine.Hostname}?")" Confirm="@($"Delete on {clone.Machine.Machine.Hostname}")" What="@($"Delete {Relative(clone.Entry.Path, dir.Path)} on {clone.Machine.Machine.Hostname}")" />
                                </td>
                            </tr>
                        }
                        @if (dirs.Count > 1)
                        {
                            <tr @key="(clone.Machine.MachineId, clone.Entry.Path, 0)" class="build-all">
                                <td class="cell-main muted">All @dirs.Count in <span class="mono">@clone.DisplayName</span></td>
                                <td data-label="Machine" class="nowrap sub">@clone.Machine.Machine.Hostname</td>
                                <td data-label="Size" class="right nowrap"><strong>@Fmt.Size(dirs.Sum(d => d.Bytes))</strong></td>
                                <td class="right cell-buttons">
                                    <ActionButton Machine="clone.Machine" Action="AgentAction.CleanBuildDirs(clone.Entry.Path, dirs.Select(d => d.Path))" Label="Clean all build output"
                                                  Ask="@($"Delete all build output in {clone.DisplayName} on {clone.Machine.Machine.Hostname}?")" Confirm="@($"Delete {dirs.Count} folders on {clone.Machine.Machine.Hostname}")" What="@($"Delete all build output in {clone.DisplayName} on {clone.Machine.Machine.Hostname}")" />
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_findings.Count > 0)
    {
        <h2>Cleanup findings</h2>
        @foreach (var view in _findings)
        {
            <FindingCard View="view" ShowRepoLink="false" OnSnooze="SnoozeAsync" OnDismiss="DismissAsync" OnRestore="RestoreAsync" />
        }
    }

    @foreach (var clone in Repositories)
    {
        var git = clone.Git!;
        <h2>Branches <span class="muted small">on @clone.Machine.Machine.Hostname · @git.Branches.Count · default <span class="mono">@(git.DefaultBranch ?? "unknown")</span></span></h2>
        <div class="table-wrap">
            <table class="stack">
                <thead>
                    <tr><th>Branch</th><th>Upstream</th><th>State</th><th class="right">Last commit</th></tr>
                </thead>
                <tbody>
                    @foreach (var branch in git.Branches.OrderByDescending(b => b.LastCommitDate))
                    {
                        <tr>
                            <td class="cell-main">
                                <span class="mono">@branch.Name</span>
                                @foreach (var match in BranchPullRequests.For(_row.PullRequests, branch, git.Remotes.Select(r => r.Name)))
                                {
                                    <PrChip @key="match.PullRequest.Url" PullRequest="match.PullRequest" AtHead="match.AtHead" />
                                }
                                <div class="sub">@branch.Subject</div>
                            </td>
                            <td data-label="Upstream" class="mono sub @(branch.Upstream is null ? "blank" : "")">@branch.Upstream</td>
                            <td data-label="State">
                                <div class="chips">
                                    @if (branch.Name == git.DefaultBranch) { <span class="chip">default</span> }
                                    @if (_checkedOut.Contains((clone.MachineKey(), branch.Name))) { <span class="chip info">checked out</span> }
                                    @if (branch.UpstreamGone) { <span class="chip danger">upstream gone</span> }
                                    @if (branch.Upstream is null) { <span class="chip muted">no upstream</span> }
                                    @if (branch.Ahead > 0) { <span class="chip info">↑@branch.Ahead</span> }
                                    @if (branch.Behind > 0) { <span class="chip info">↓@branch.Behind</span> }
                                    @if (branch.MergedIntoDefault == true && branch.Name != git.DefaultBranch) { <span class="chip ok">merged</span> }
                                    <SyncButtons Short="true" Offers="_sync.Where(o => o.Machine.MachineId == clone.Machine.MachineId && o.RepoPath == clone.Entry.Path && o.Branch == branch.Name).ToList()" />
                                </div>
                            </td>
                            <td data-label="Last commit" class="right nowrap sub" title="@Fmt.Date(branch.LastCommitDate)">@Fmt.Ago(branch.LastCommitDate, Now)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (git.Worktrees.Count > 1)
        {
            <h2>Worktrees <span class="muted small">on @clone.Machine.Machine.Hostname · @git.Worktrees.Count</span></h2>
            <div class="table-wrap">
                <table class="stack">
                    <thead><tr><th>Path</th><th>Branch</th><th>State</th></tr></thead>
                    <tbody>
                        @foreach (var (wt, index) in git.Worktrees.Select((w, i) => (w, i)))
                        {
                            <tr>
                                <td class="mono path cell-main">@wt.Path</td>
                                <td data-label="Branch" class="mono">@(wt.Branch ?? $"detached @ {Fmt.Sha(wt.Head)}")</td>
                                <td data-label="State">
                                    <div class="chips">
                                        @if (index == 0) { <span class="chip">main working tree</span> }
                                        @if (wt.Prunable) { <span class="chip danger" title="@wt.PrunableReason">prunable</span> }
                                        @if (wt.Locked) { <span class="chip muted">locked</span> }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (git.Stashes.Count > 0)
        {
            <h2>Stashes <span class="muted small">on @clone.Machine.Machine.Hostname · @git.Stashes.Count</span></h2>
            <div class="table-wrap">
                <table>
                    <tbody>
                        @foreach (var stash in git.Stashes)
                        {
                            <tr>
                                <td class="mono nowrap">@($"stash@{{{stash.Index}}}")</td>
                                <td>@stash.Message</td>
                                <td class="right nowrap sub" title="@Fmt.Date(stash.Date)">@Fmt.Ago(stash.Date, Now)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
}

@code {
    [SupplyParameterFromQuery] public string? Key { get; set; }

    private RepoRow? _row;
    private List<FindingView> _findings = [];
    private IReadOnlyDictionary<string, List<CloneView>> _clonesByKey = new Dictionary<string, List<CloneView>>();
    private HashSet<(string Machine, string Branch)> _checkedOut = [];
    private IReadOnlyList<RefreshTarget> _targets = [];
    private IReadOnlyList<SyncOffer> _sync = [];
    private IReadOnlyDictionary<(string MachineId, string Path), SafetyAssessment> _safety = new Dictionary<(string, string), SafetyAssessment>();

    /// <summary>The top button is offered when any machine can take a refresh; otherwise it says why none can.</summary>
    private RefreshAvailability AllAvailability
    {
        get
        {
            var each = _targets.Select(t => Refreshes.For(t.Machine)).ToList();
            return each.Any(a => a.Available)
                ? new RefreshAvailability(true, null)
                : new RefreshAvailability(false, string.Join(" ", each.Select(a => a.WhyNot).Distinct()));
        }
    }

    private RefreshStatus AllStatus => RefreshStatus.Combine(_targets.Where(t => Refreshes.For(t.Machine).Available || Refreshes.StatusOf(t).Phase != RefreshPhase.Idle).Select(Refreshes.StatusOf).ToList());

    private string AllWhat
    {
        get
        {
            var able = _targets.Where(t => Refreshes.For(t.Machine).Available).Select(t => t.Machine.Machine.Hostname).Distinct().ToList();
            var unable = _targets.Select(t => Refreshes.For(t.Machine)).Where(a => !a.Available).Select(a => a.WhyNot).Distinct().ToList();
            return $"Rescan this repo on {string.Join(", ", able)} now: fetch (where that machine fetches), sizes and state"
                + (unable.Count == 0 ? "" : ". Not included: " + string.Join(" ", unable));
        }
    }

    private async Task RefreshAsync(IReadOnlyList<RefreshTarget> targets)
    {
        await Refreshes.QueueAsync(targets);
        TickWhile(() => Refreshes.Ticking);
    }

    private IReadOnlyDictionary<DateOnly, int> _activity = new Dictionary<DateOnly, int>();
    private bool _hasActivity;
    private int? _mine;

    private DateOnly Today => DateOnly.FromDateTime(Time.GetLocalNow().DateTime);

    /// <summary>Working trees that pin a tool version.</summary>
    private List<CloneView> Pinned => (_row?.Clones ?? []).Where(c => c.Entry.Pins is { Count: > 0 }).ToList();

    /// <summary>Working trees whose dependencies an agent has checked.</summary>
    private List<CloneView> Checked => (_row?.Clones ?? []).Where(c => c.Entry.Dependencies is { Reports.Count: > 0 }).ToList();

    /// <summary>Working trees with build output measured: what Clean can delete. Repositories only, since the agent asks git what is tracked.</summary>
    private List<CloneView> BuildOutputs => (_row?.Clones ?? []).Where(c => c.Entry is { Kind: EntryKind.GitRepo, Size.ReclaimableDirs.Count: > 0 }).ToList();

    /// <summary>A folder relative to its working tree, keeping the reporting machine's separators.</summary>
    private static string Relative(string root, string path) =>
        path.Length > root.Length + 1 && path.StartsWith(root, StringComparison.Ordinal) ? path[(root.Length + 1)..] : path;

    /// <summary>Clones with a folder to open: everything but loose files.</summary>
    private List<CloneView> Openable => (_row?.Clones ?? []).Where(c => c.Entry.Kind != EntryKind.LooseFile).ToList();

    /// <summary>One clone per repository per machine: branches, worktrees and stashes are shared by linked worktrees.</summary>
    private IEnumerable<CloneView> Repositories => (_row?.Clones ?? [])
        .Where(c => c.Git is not null)
        .GroupBy(c => (c.Machine.MachineId, c.Git!.CommonDir ?? c.Entry.Path))
        .Select(g => g.OrderBy(c => c.Git!.IsLinkedWorktree).First());

    protected override async Task OnParametersSetAsync()
    {
        if (Loaded)
        {
            await LoadAsync();
        }
    }

    protected override async Task LoadAsync()
    {
        _row = string.IsNullOrEmpty(Key) ? null : await Catalog.FindAsync(Key);
        _clonesByKey = Catalog.ClonesByGitHubKey();
        _targets = RefreshTargets.For(_row?.Clones ?? []);
        _safety = SafetyRows.ByClone();
        await Refreshes.LoadAsync();
        await Actions.LoadAsync();
        _sync = SyncOffers.For(_row?.Clones ?? []);
        TickWhile(() => Refreshes.Ticking);
        if (_row is null)
        {
            _findings = [];
            _hasActivity = false;
            return;
        }

        _hasActivity = ActivityView.Any([_row]);
        _activity = ActivityView.ForRepo(_row, mine: false);
        var first = Today.AddDays(-(ActivityView.Days - 1));
        _mine = ActivityView.AnyMine([_row]) ? ActivityView.ForRepo(_row, mine: true).Where(d => d.Key >= first && d.Key <= Today).Sum(d => d.Value) : null;

        var paths = _row.Clones.Select(c => (c.Machine.MachineId, c.Entry.Path)).ToHashSet();
        _findings = (await Findings.GetAsync())
            .Where(v => string.Equals(v.Finding.RepoKey, _row.Key, StringComparison.OrdinalIgnoreCase)
                || (v.Finding.MachineId is not null && v.Finding.Path is not null && paths.Contains((v.Finding.MachineId, v.Finding.Path))))
            .ToList();

        _checkedOut = _row.Clones
            .Where(c => c.Git is not null)
            .SelectMany(c => c.Git!.Worktrees.Where(w => w.Branch is not null).Select(w => (c.MachineKey(), w.Branch!)))
            .ToHashSet();
    }

    private async Task SnoozeAsync((Finding Finding, int Days) args) => await Findings.SnoozeAsync(args.Finding, TimeSpan.FromDays(args.Days));

    private async Task DismissAsync(Finding finding) => await Findings.DismissAsync(finding);

    private async Task RestoreAsync(Finding finding) => await Findings.RestoreAsync(finding.Fingerprint);
}
